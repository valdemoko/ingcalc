# ============================================================
# IngCalc — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================

# --- REQUIRED FOR PRODUCTION ---

# Public site URL (no trailing slash). Used for canonicals, sitemap, OG tags, JSON-LD.
# Example: https://ingcalc.com
NEXT_PUBLIC_SITE_URL=https://ingcalc.example.com

# --- CONTACT ---

# Public contact email (shown on /contact page).
# Leave empty and the page shows a notice instead of inventing an address.
NEXT_PUBLIC_CONTACT_EMAIL=

# Author's LinkedIn profile URL (shown on /about/author and in the footer).
NEXT_PUBLIC_AUTHOR_LINKEDIN=https://www.linkedin.com/in/miguel-iglesias-valenzuela-14069b367/

# --- ADVERTISING ---

# Google AdSense publisher ID (e.g. ca-pub-1234567890123456).
# Leave empty to run with ads completely disabled.
NEXT_PUBLIC_ADSENSE_CLIENT=

# --- CONSENT / GDPR ---

# Google-certified CMP script URL (e.g. CookieYes) for EEA/GDPR consent.
# Leave empty to use the built-in consent banner (not Google-certified).
NEXT_PUBLIC_CMP_SRC=

# --- ANALYTICS ---

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to disable analytics.
NEXT_PUBLIC_GA4_ID=

# Google Search Console verification content (the content attribute value).
# Leave empty if verifying via DNS instead of meta tag.
NEXT_PUBLIC_SC_VERIFICATION=
