{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Static deployment (`STATIC_EXPORT=1 next build` -> out/). Assets-only apart
	// from the verification file. Same Worker name as the OpenNext build, so the
	// custom domain keeps pointing at it. wrangler.jsonc stays as the rollback path.
	"name": "ingcalc",
	"main": "./static-worker/index.js",
	"compatibility_date": "2026-09-30",
	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": ["/google7df3871b09d28084.html"]
	}
}
